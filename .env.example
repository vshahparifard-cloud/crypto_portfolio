# ---- app -------------------------------------------------------------------
APP_ENV=dev
SECRET_KEY=change-me-32-bytes-minimum-please-rotate
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- data stores -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://coinpulse:coinpulse@postgres:5432/coinpulse
REDIS_URL=redis://redis:6379/0

# ---- coingecko (D1: one call per POLL_INTERVAL_SECONDS, 50 coins per call) --
# free demo plan: ~10,000 calls/month. 300s => ~8,640/month. DO NOT lower
# below 300 without a paid key or the monthly cap is blown mid-month.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_DEMO_KEY=
POLL_INTERVAL_SECONDS=300
TOP_N_COINS=50

# ---- telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CoinPulseBot
TELEGRAM_WEBHOOK_SECRET=change-me-too

# ---- email (provider agnostic, D11) ---------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CoinPulse <no-reply@coinpulse.local>
SMTP_STARTTLS=false

# ---- limits ----------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_ACTIVE_ALERTS=50
